@page "/login"
@inject DemoAuthService Auth
@inject NavigationManager Nav

<PageTitle>Sign In — Room &amp; Coworking Booking</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <span class="auth-logo">RB</span>
            <h1>Room &amp; Coworking Booking</h1>
            <p class="text-muted">University Campus &amp; Astana Tech Hubs</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="auth-alert auth-alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="auth-alert auth-alert-success">@_info</div>
        }

        <div @onkeydown="HandleKeyDown">
            <div class="auth-field">
                <label class="form-label" for="login-email">Corporate or University Email</label>
                <input id="login-email"
                       type="email"
                       class="form-control"
                       placeholder="name@roombooking.kz"
                       @bind="_email"
                       @bind:event="oninput" />
            </div>

            <div class="auth-field">
                <label class="form-label" for="login-password">Password</label>
                <div class="password-input-wrapper">
                    <input id="login-password"
                           type="@(_showPassword ? "text" : "password")"
                           class="form-control password-input"
                           placeholder="••••••••"
                           @bind="_password"
                           @bind:event="oninput" />
                    <button type="button"
                            class="password-toggle-btn"
                            aria-label="@(_showPassword ? "Hide password" : "Show password")"
                            @onclick="TogglePasswordVisibility">
                        @if (_showPassword)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <button type="button" class="link-btn" @onclick="OpenForgotModal">Forgot password?</button>
                </div>
            </div>

            <button type="button"
                    class="btn btn-primary w-100 auth-submit"
                    disabled="@_busy"
                    @onclick="HandleLoginAsync">
                @(_busy ? "Signing in..." : "Sign In")
            </button>
        </div>

        <div class="text-center mt-4">
            <span class="text-muted small">Protected by Role-Based Access Control (RBAC)</span>
        </div>
    </div>
</div>

@if (_showForgotModal)
{
    <div class="rb-modal-overlay" @onclick="CloseForgotModal">
        <div class="rb-modal-dialog" @onclick:stopPropagation>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold m-0 rb-modal-title">Reset Password</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForgotModal"></button>
            </div>

            <p class="text-muted small mb-3">
                Enter your registered email and set a new password for your account.
            </p>

            @if (!string.IsNullOrEmpty(_resetError))
            {
                <div class="auth-alert auth-alert-danger mb-3">@_resetError</div>
            }

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Corporate or University Email</label>
                <input type="email" class="form-control" @bind="_resetEmail" placeholder="name@roombooking.kz" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">New Password</label>
                <input type="password" class="form-control" @bind="_resetNewPassword" placeholder="Minimum 6 characters" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-light" @onclick="CloseForgotModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="HandleResetPassword">Update Password</button>
            </div>
        </div>
    </div>
}

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _showPassword;
    private string? _error;
    private string? _info;
    private bool _busy;

    private bool _showForgotModal;
    private string _resetEmail = string.Empty;
    private string _resetNewPassword = string.Empty;
    private string? _resetError;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLoginAsync();
        }
    }

    private async Task HandleLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Please enter both email and password.";
            return;
        }

        _busy = true;
        _error = null;
        _info = null;

        try
        {
            var (success, error) = await Auth.SignInAsync(_email.Trim(), _password);
            if (!success)
            {
                _error = error ?? "Invalid email or password.";
                return;
            }

            if (Nav.ToBaseRelativePath(Nav.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            _error = $"Sign-in error: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenForgotModal()
    {
        _resetEmail = _email;
        _resetNewPassword = string.Empty;
        _resetError = null;
        _showForgotModal = true;
    }

    private void CloseForgotModal() => _showForgotModal = false;

    private void HandleResetPassword()
    {
        _resetError = null;
        var (success, error) = Auth.ResetPassword(_resetEmail, _resetNewPassword);
        if (!success)
        {
            _resetError = error;
            return;
        }

        _email = _resetEmail.Trim();
        _password = _resetNewPassword;
        _showForgotModal = false;
        _info = "Password updated. You can sign in now.";
    }
}